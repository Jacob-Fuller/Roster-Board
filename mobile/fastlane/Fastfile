# Roster Board native app (mobile/): build on GitHub's Macs and upload to TestFlight.
# Uses the same App Store Connect key and signing certificate as the earlier
# iPhone builds (fastlane-match branch). See .github/workflows/mobile-ios.yml.
require "base64"

default_platform(:ios)

APP_ID = "net.rosterboard.app"
WIDGET_ID = "net.rosterboard.app.widget"

platform :ios do
  def asc_key
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8 MATCH_PASSWORD].each do |k|
      UI.user_error!("Missing GitHub secret #{k}. See native/IOS-SETUP.md.") if ENV[k].to_s.strip.empty?
    end
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"].strip,
      issuer_id: ENV["ASC_ISSUER_ID"].strip,
      key_content: ENV["ASC_KEY_P8"],
      in_house: false
    )
  end

  desc "Build the native app and upload it to TestFlight"
  lane :beta do
    api_key = asc_key
    setup_ci
    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "fastlane-match",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['GH_TOKEN']}"),
      api_key: api_key,
      readonly: true
    )

    # The home screen widget is its own small app inside Roster Board, with its own
    # identifier and provisioning profile. Register the identifier once, then make
    # (or download) its App Store profile signed with the same certificate.
    widget_target = nil
    if Dir.exist?("../ios") && Dir.glob("../ios/*.xcodeproj/project.pbxproj").any? { |f| File.read(f).include?("RosterBoardWidget") }
      widget_target = "RosterBoardWidget"
      unless Spaceship::ConnectAPI::BundleId.find(WIDGET_ID)
        Spaceship::ConnectAPI::BundleId.create(name: "Roster Board Widget", platform: "IOS", identifier: WIDGET_ID)
        UI.message("Registered #{WIDGET_ID}")
      end
      cert = Spaceship::ConnectAPI::Certificate.all.find { |c| c.certificate_type.to_s.include?("DISTRIBUTION") && c.expiration_date.to_s > Time.now.utc.iso8601 }
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: WIDGET_ID,
        provisioning_name: "Roster Board Widget AppStore",
        ignore_profiles_with_different_name: true,
        cert_id: cert && cert.id,
        force: false,
        filename: "widget.mobileprovision"
      )
      widget_profile = lane_context[SharedValues::SIGH_NAME]
    end

    # Expo names the Xcode project after the app ("RosterBoard").
    project = Dir.glob("../ios/*.xcodeproj").first or UI.user_error!("No iOS project. Run expo prebuild first.")
    workspace = Dir.glob("../ios/*.xcworkspace").first
    scheme = File.basename(project, ".xcodeproj")
    project = project.sub("../", "")
    workspace = workspace&.sub("../", "")

    team_id = ENV["sigh_#{APP_ID}_appstore_team-id"]
    profile = ENV["sigh_#{APP_ID}_appstore_profile-name"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      team_id: team_id,
      bundle_identifier: APP_ID,
      profile_name: profile,
      code_sign_identity: "Apple Distribution",
      targets: [scheme]
    )

    if widget_target
      update_code_signing_settings(
        use_automatic_signing: false,
        path: project,
        team_id: team_id,
        bundle_identifier: WIDGET_ID,
        profile_name: widget_profile,
        code_sign_identity: "Apple Distribution",
        targets: [widget_target]
      )
    end

    last = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
    # Expo writes the build number straight into Info.plist.
    set_info_plist_value(path: "ios/#{scheme}/Info.plist", key: "CFBundleVersion", value: (last.to_i + 1).to_s)
    if widget_target
      # the widget's version and build number must match the app's
      app_version = get_info_plist_value(path: "ios/#{scheme}/Info.plist", key: "CFBundleShortVersionString")
      widget_plist = "targets/widget/Info.plist" # actions run from mobile/, Ruby here runs from mobile/fastlane
      set_info_plist_value(path: widget_plist, key: "CFBundleVersion", value: (last.to_i + 1).to_s)
      set_info_plist_value(path: widget_plist, key: "CFBundleShortVersionString", value: app_version.to_s)
    end

    build_app(
      workspace: workspace,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: widget_target ? { APP_ID => profile, WIDGET_ID => widget_profile } : { APP_ID => profile } },
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Uploaded build #{last.to_i + 1} to TestFlight.")
  end
end
