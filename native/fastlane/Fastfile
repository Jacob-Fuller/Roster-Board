# Roster Board iOS: build and upload to TestFlight from GitHub Actions.
# See .github/workflows/ios-testflight.yml and native/IOS-SETUP.md.
require "base64"

default_platform(:ios)

APP_ID = "net.rosterboard.app"
PROJECT = "ios/App/App.xcodeproj"

platform :ios do
  def asc_key
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8 MATCH_PASSWORD].each do |k|
      UI.user_error!("Missing GitHub secret #{k}. See native/IOS-SETUP.md.") if ENV[k].to_s.strip.empty?
    end
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"].strip,
      issuer_id: ENV["ASC_ISSUER_ID"].strip,
      key_content: ENV["ASC_KEY_P8"],
      in_house: false
    )
  end

  # Registers the app ID with Apple if it isn't there yet.
  def ensure_bundle_id
    existing = Spaceship::ConnectAPI::BundleId.find(APP_ID)
    if existing
      UI.message("App ID #{APP_ID} already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "Roster Board", platform: "IOS", identifier: APP_ID)
      UI.success("Registered app ID #{APP_ID}")
    end
  end

  # Distribution certificate + App Store profile, stored encrypted on the
  # fastlane-match branch of this repo so every build reuses the same ones.
  def signing(api_key)
    setup_ci
    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "fastlane-match",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['GH_TOKEN']}"),
      api_key: api_key,
      readonly: false
    )
  end

  desc "One-off: register the app ID and create the signing certificate"
  lane :setup do
    api_key = asc_key
    ensure_bundle_id
    signing(api_key)
    UI.success("Setup done. Next: create the app in App Store Connect, then run the 'beta' lane.")
  end

  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = asc_key
    ensure_bundle_id
    signing(api_key)

    team_id = ENV["sigh_#{APP_ID}_appstore_team-id"]
    profile = ENV["sigh_#{APP_ID}_appstore_profile-name"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: team_id,
      bundle_identifier: APP_ID,
      profile_name: profile,
      code_sign_identity: "Apple Distribution",
      targets: ["App"]
    )

    begin
      last = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
    rescue => e
      UI.user_error!("Couldn't find the app in App Store Connect. Create it first (My Apps -> + -> New App, bundle ID #{APP_ID}). (#{e.message})")
    end
    increment_build_number(xcodeproj: PROJECT, build_number: last.to_i + 1)

    workspace = "ios/App/App.xcworkspace"
    build_app(
      workspace: File.exist?(File.join("..", workspace)) ? workspace : nil,
      project: File.exist?(File.join("..", workspace)) ? nil : PROJECT,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "TARGETED_DEVICE_FAMILY=1",  # iPhone only, so no iPad screenshots are required
      export_options: { provisioningProfiles: { APP_ID => profile } },
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Uploaded build #{last.to_i + 1} to TestFlight. It shows up in App Store Connect after Apple processes it (usually 10-30 minutes).")
  end

  desc "Attach the newest processed build to the App Store version being prepared"
  lane :select_build do
    asc_key
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found in App Store Connect") unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version") unless version
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10)
    builds.each { |b| UI.message("build #{b.version} uploaded #{b.uploaded_date} state #{b.processing_state} expired=#{b.expired}") }
    want = ENV["BUILD_NUMBER"].to_s.strip
    build = want.empty? ? builds.find { |b| b.processing_state == "VALID" && !b.expired } : builds.find { |b| b.version == want }
    UI.user_error!("No processed build found#{want.empty? ? '' : " with number #{want}"}") unless build
    UI.user_error!("Build #{build.version} is still processing (#{build.processing_state})") unless build.processing_state == "VALID"
    min = ENV["MIN_UPLOADED"].to_s.strip
    if !min.empty? && Time.parse(build.uploaded_date.to_s) < Time.parse(min)
      UI.user_error!("Newest processed build #{build.version} was uploaded #{build.uploaded_date}, before #{min}: the native build isn't processed yet")
    end
    if build.uses_non_exempt_encryption.nil?
      Spaceship::ConnectAPI.patch_builds(build_id: build.id, attributes: { usesNonExemptEncryption: false })
    end
    version.select_build(build_id: build.id)
    current = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS, includes: "build").build
    UI.user_error!("Build didn't attach") unless current && current.id == build.id
    UI.success("Version #{version.version_string} now uses build #{build.version} (uploaded #{build.uploaded_date})")
  end

  desc "Replace the iPhone screenshots on the App Store listing (no build, no metadata)"
  lane :screenshots do
    api_key = asc_key
    files = ENV.fetch("SCREENSHOTS", "").split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("No screenshots listed") if files.empty?
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found in App Store Connect") unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version. Screenshots can't change while the app is in review.") unless version
    locales = version.get_app_store_version_localizations.map(&:locale)
    UI.message("Version #{version.version_string} (#{version.app_store_state}), languages: #{locales.join(', ')}")
    out = File.expand_path("../build/screenshots", __dir__)
    FileUtils.rm_rf(out)
    locales.each do |loc|
      dir = File.join(out, loc)
      FileUtils.mkdir_p(dir)
      files.each_with_index do |f, i|
        FileUtils.cp(File.expand_path("../appstore-screenshots/#{f}", __dir__), File.join(dir, format("%02d_%s", i + 1, f)))
      end
    end
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      screenshots_path: out,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
    # Check what App Store Connect actually holds now: every language must have exactly
    # these files, in this order (matched by checksum). Fail the run if not.
    require "digest"
    want = files.map { |f| Digest::MD5.hexdigest(File.binread(File.expand_path("../appstore-screenshots/#{f}", __dir__))) }
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    problems = []
    version.get_app_store_version_localizations.each do |loc|
      iphone = loc.get_app_screenshot_sets.select { |s| s.screenshot_display_type.to_s.start_with?("APP_IPHONE") }
      iphone.each do |set|
        shots = set.app_screenshots.to_a
        got = shots.map(&:source_file_checksum)
        UI.message("#{loc.locale} #{set.screenshot_display_type}: #{shots.length} screenshots")
        problems << "#{loc.locale} #{set.screenshot_display_type}: #{shots.length} on App Store Connect, expected #{files.length} matching files" if got != want
      end
      problems << "#{loc.locale}: no iPhone screenshots" if iphone.empty?
    end
    UI.user_error!("Screenshots on App Store Connect don't match: #{problems.join('; ')}") unless problems.empty?
    UI.success("Verified: #{files.length} screenshots on App Store Connect for #{locales.join(', ')}")
  end
  desc "Read everything App Store Connect holds for the app into build/asc-report.json"
  lane :asc_report do
    asc_key
    require "json"
    c = Spaceship::ConnectAPI.client.tunes_request_client
    get = lambda do |path, params = {}|
      begin
        r = c.get(path, params)
        r.body
      rescue => e
        { "error" => e.message }
      end
    end
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App not found") unless app
    out = { "app" => get.call("v1/apps/#{app.id}") }
    infos = get.call("v1/apps/#{app.id}/appInfos")
    out["appInfos"] = infos
    (infos["data"] || []).each do |info|
      id = info["id"]
      out["appInfo_#{id}_localizations"] = get.call("v1/appInfos/#{id}/appInfoLocalizations")
      out["appInfo_#{id}_ageRating"] = get.call("v1/appInfos/#{id}/ageRatingDeclaration")
      out["appInfo_#{id}_primaryCategory"] = get.call("v1/appInfos/#{id}/primaryCategory")
      out["appInfo_#{id}_secondaryCategory"] = get.call("v1/appInfos/#{id}/secondaryCategory")
    end
    versions = get.call("v1/apps/#{app.id}/appStoreVersions", { "limit" => 5 })
    out["versions"] = versions
    (versions["data"] || []).each do |v|
      id = v["id"]
      out["version_#{id}_localizations"] = get.call("v1/appStoreVersions/#{id}/appStoreVersionLocalizations")
      out["version_#{id}_reviewDetail"] = get.call("v1/appStoreVersions/#{id}/appStoreReviewDetail")
      out["version_#{id}_build"] = get.call("v1/appStoreVersions/#{id}/build")
    end
    out["iaps"] = get.call("v1/apps/#{app.id}/inAppPurchasesV2", { "limit" => 50 })
    (out["iaps"]["data"] || []).each do |i|
      out["iap_#{i['id']}_localizations"] = get.call("v2/inAppPurchases/#{i['id']}/inAppPurchaseLocalizations")
    end
    groups = get.call("v1/apps/#{app.id}/subscriptionGroups", { "include" => "subscriptions" })
    out["subscriptionGroups"] = groups
    (groups["data"] || []).each do |g|
      out["group_#{g['id']}_localizations"] = get.call("v1/subscriptionGroups/#{g['id']}/subscriptionGroupLocalizations")
      subs = get.call("v1/subscriptionGroups/#{g['id']}/subscriptions")
      out["group_#{g['id']}_subscriptions"] = subs
      (subs["data"] || []).each do |s|
        out["sub_#{s['id']}_localizations"] = get.call("v1/subscriptions/#{s['id']}/subscriptionLocalizations")
      end
    end
    out["builds"] = get.call("v1/builds", { "filter[app]" => app.id, "sort" => "-uploadedDate", "limit" => 5 })
    out["availability"] = get.call("v1/apps/#{app.id}/appAvailabilityV2")
    path = File.expand_path("../build/asc-report.json", __dir__)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, JSON.pretty_generate(out))
    UI.success("Wrote #{path}")
  end
  desc "Apply native/listing/app-store.json to the App Store version being prepared"
  lane :asc_update do
    asc_key
    require "json"
    lst = JSON.parse(File.read(File.expand_path("../listing/app-store.json", __dir__)))
    c = Spaceship::ConnectAPI.client.tunes_request_client
    results = []
    patch = lambda do |path, type, id, attrs|
      body = { data: { type: type, id: id, attributes: attrs } }
      begin
        r = c.patch(path, body)
        ok = r.status.to_i < 300
        results << { path: path, fields: attrs.keys, status: r.status, error: ok ? nil : r.body }
      rescue => e
        results << { path: path, fields: attrs.keys, error: e.message }
      end
    end
    at_exit_write = lambda do
      f = File.expand_path("../build/asc-update.json", __dir__)
      FileUtils.mkdir_p(File.dirname(f)); File.write(f, JSON.pretty_generate(results))
    end
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version") unless version
    patch.call("v1/appStoreVersions/#{version.id}", "appStoreVersions", version.id, { copyright: lst["copyright"] })
    version.get_app_store_version_localizations.each do |loc|
      patch.call("v1/appStoreVersionLocalizations/#{loc.id}", "appStoreVersionLocalizations", loc.id,
        { description: lst["description"], keywords: lst["keywords"], promotionalText: lst["promotionalText"], marketingUrl: lst["marketingUrl"] })
    end
    rd = c.get("v1/appStoreVersions/#{version.id}/appStoreReviewDetail").body["data"]
    UI.user_error!("No review detail on the version") unless rd
    patch.call("v1/appStoreReviewDetails/#{rd['id']}", "appStoreReviewDetails", rd["id"], { notes: lst["reviewNotes"] })
    (c.get("v1/apps/#{app.id}/inAppPurchasesV2").body["data"] || []).each do |iap|
      cfg = lst["iap"][iap["attributes"]["productId"]] or next
      patch.call("v2/inAppPurchases/#{iap['id']}", "inAppPurchases", iap["id"], { reviewNote: cfg["reviewNote"] })
      (c.get("v2/inAppPurchases/#{iap['id']}/inAppPurchaseLocalizations").body["data"] || []).each do |l|
        patch.call("v1/inAppPurchaseLocalizations/#{l['id']}", "inAppPurchaseLocalizations", l["id"], { description: cfg["description"] })
      end
    end
    (c.get("v1/apps/#{app.id}/subscriptionGroups").body["data"] || []).each do |g|
      (c.get("v1/subscriptionGroups/#{g['id']}/subscriptions").body["data"] || []).each do |sub|
        cfg = lst["iap"][sub["attributes"]["productId"]] or next
        patch.call("v1/subscriptions/#{sub['id']}", "subscriptions", sub["id"], { reviewNote: cfg["reviewNote"] })
        (c.get("v1/subscriptions/#{sub['id']}/subscriptionLocalizations").body["data"] || []).each do |l|
          patch.call("v1/subscriptionLocalizations/#{l['id']}", "subscriptionLocalizations", l["id"], { description: cfg["description"] })
        end
      end
    end
    at_exit_write.call
    failed = results.select { |x| x[:error] }
    UI.user_error!("#{failed.length} of #{results.length} updates failed") unless failed.empty?
    UI.success("Listing updated (#{results.length} changes)")
  end
end
